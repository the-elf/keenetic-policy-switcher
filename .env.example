# Router's base URL on the local network. LAN/127.0.0.1 only — KeenDNS
# and any external access are not supported (see README).
KEENETIC_HOST=http://192.168.1.1

# Router admin login.
KEENETIC_LOGIN=admin

# Router admin password. Never commit a real value.
KEENETIC_PASSWORD=

# Address and port the app itself listens on.
# Keep it on a trusted LAN or on 127.0.0.1 — the service has full
# administrative access to the router.
LISTEN_ADDR=:8080

# Optional: timeout for requests to the router (time.Duration format, e.g. 10s).
# Defaults to 10s.
#REQUEST_TIMEOUT=10s
