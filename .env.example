# Router's base URL on the local network. LAN/127.0.0.1 only — KeenDNS
# and any external access are not supported (see README).
KEENETIC_HOST=http://192.168.1.1

# Router admin login.
KEENETIC_LOGIN=admin

# Router admin password. Never commit a real value.
KEENETIC_PASSWORD=

# Optional: interface the app binds to. Empty means all interfaces.
# Running directly (no Docker): set to 127.0.0.1 to restrict access to this
# machine, or leave empty to allow the LAN in — the service has full
# administrative access to the router.
# Running under Docker Compose: leave this empty. Docker's port publishing
# forwards host traffic to the container's external interface, not its
# loopback — setting 127.0.0.1 here makes the container unreachable even
# through the published HOST_PORT. Restrict access via HOST_PORT/firewall
# instead (see the ports comment in docker-compose.yml).
#APP_HOST=

# Optional: port the app listens on. Under Docker Compose this is also the
# container side of the HOST_PORT mapping below, so change it here (not in
# docker-compose.yml) to move the app to a different port. Defaults to 8080.
#APP_PORT=8080

# Optional: timeout for requests to the router (time.Duration format, e.g. 10s).
# Defaults to 10s.
#REQUEST_TIMEOUT=10s

# Optional: path to the JSON file storing the shared favorite-devices list.
# Defaults to favorites.json in the current directory (created on first use).
# Docker Compose overrides this itself (see docker-compose.yml) — no need to
# set it here for the Docker setup.
#FAVORITES_FILE=favorites.json

# Optional: host port Docker Compose publishes the app on. Defaults to 8080.
#HOST_PORT=8080
